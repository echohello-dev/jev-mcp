{
  "name": "@echohello/jev-mcp",
  "version": "2026.09.23",
  "description": "Minimal MCP server exposing TypeSafe/OpenRouter /api/alpha/decisions as judgment tools.",
  "type": "module",
  "bin": {
    "jev-mcp": "./dist/index.js"
  },
