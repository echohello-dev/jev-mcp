  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typesafe",
    "jev",
    "claude-code",
    "opencode"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5"
  }
}